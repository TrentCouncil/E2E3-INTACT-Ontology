  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "This class comprises pieces of land or sea floor. In contrast to the purely geometric notion of E53 Place, this class describes constellations of matter on the surface of the Earth or other celestial body, which can be represented by photographs, paintings and maps. Instances of E27 Site are composed of relatively immobile material items and features in a particular configuration at a particular location."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "E27 Site"
  } ],
